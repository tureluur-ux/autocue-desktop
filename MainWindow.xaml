<Window x:Class="AutoCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCue" Height="820" Width="1280" MinHeight="620" MinWidth="900"
        Background="#0B1020" Foreground="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111A2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#24314A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#95A3BA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Background" Value="#1B2942"/>
            <Setter Property="BorderBrush" Value="#30415F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263958"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#47D7AC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="13" Background="#163B3B" Margin="0,0,13,0">
                    <TextBlock Text="A" Foreground="#47D7AC" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="AutoCue" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="FOCUS ON YOUR DELIVERY" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" Margin="1,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="New script" Click="NewScript_Click" Margin="0,0,8,0"/>
                <Button Content="Open script" Click="OpenScript_Click" Margin="0,0,8,0"
                        Background="#47D7AC" BorderBrush="#47D7AC" Foreground="#071511"/>
                <Button Content="Save .txt" Click="SaveScript_Click" Margin="0,0,8,0"/>
                <Button x:Name="EditScriptButton" Content="Edit" Click="EditScript_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <DockPanel Margin="0,0,0,9">
                        <TextBlock Text="SCROLL SPEED" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="SpeedValueText" DockPanel.Dock="Right" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#47D7AC"/>
                    </DockPanel>
                    <Slider x:Name="SpeedSlider" Minimum="10" Maximum="240" Value="42"
                            TickFrequency="10" IsSnapToTickEnabled="False"
                            ValueChanged="SpeedSlider_ValueChanged"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0B1020" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Aa" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <Slider x:Name="FontSizeSlider" Width="92" Minimum="24" Maximum="56" Value="36"
                                ValueChanged="FontSizeSlider_ValueChanged"/>
                        <TextBlock x:Name="FontSizeText" Foreground="#D7DEEB" VerticalAlignment="Center"
                                   Width="38" TextAlignment="Right" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Button x:Name="PlayButton" Grid.Column="2" Content="▶  Start reading"
                        Click="PlayButton_Click" Padding="18,11" MinWidth="154"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#080C17" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid x:Name="EmptyState" Margin="32" AllowDrop="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <Border Width="66" Height="66" CornerRadius="20" Background="#142238"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="↑" FontSize="34" Foreground="#47D7AC"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Your script, in the spotlight" FontSize="23" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Open a plain-text file or drop it here to get started."
                                   FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,20"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Create a script" Click="NewScript_Click"
                                    Background="#47D7AC" BorderBrush="#47D7AC" Foreground="#071511"
                                    Margin="0,0,8,0"/>
                            <Button Content="Open a text file" Click="OpenScript_Click"/>
                        </StackPanel>
                        <TextBlock Text="Supports .TXT and .MD" FontSize="11" Foreground="#65738A"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ScriptScrollViewer" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Padding="8,55" CanContentScroll="False">
                    <TextBlock x:Name="ScriptText" Foreground="#F3F4F6" TextWrapping="Wrap"
                               TextAlignment="Center" FontFamily="Segoe UI" LineHeight="57"
                               MaxWidth="850" HorizontalAlignment="Center"/>
                </ScrollViewer>
                <TextBox x:Name="ScriptEditor" Visibility="Collapsed" Margin="24,58,24,24"
                         Background="#0B1020" Foreground="#F3F4F6" CaretBrush="#47D7AC"
                         BorderThickness="0" FontFamily="Segoe UI" FontSize="20"
                         Padding="22" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="ScriptEditor_TextChanged"/>
                <Border x:Name="ScriptHeader" Visibility="Collapsed" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="18,16,0,0" Background="#10192B"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,6">
                    <TextBlock x:Name="FileNameText" FontSize="12" Foreground="#AAB6C8"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,14,2,0">
            <TextBlock x:Name="StatusText" Text="Ready when you are"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#65738A" Margin="0,0,8,0"/>
                <TextBlock x:Name="PlaybackStatusText" Text="PAUSED" FontSize="10" FontWeight="Bold"
                   Foreground="#95A3BA" VerticalAlignment="Center"/>
                <TextBlock Text="   SPACE  play / pause" FontSize="10" Foreground="#65738A"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
